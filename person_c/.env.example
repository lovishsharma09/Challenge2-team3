# Copy to .env and fill in. NEVER commit .env (the repo .gitignore must contain it).
# --- Text inference: Tesseracted shared AI gateway (OpenAI-compatible) -> see the Tesseracted one-pager
# Base URL WITHOUT /v1 (the client adds it). The URL contains an access path: treat it like a secret.
LLM_BASE_URL=
LLM_API_KEY=
# Models offered by the gateway are listed in the one-pager; `python run_c.py --models` prints the live list.
LLM_MODEL=zai-org/GLM-5.3          # suggestion from the gateway list, UNTESTED – check with --ping
# Optional: a different model for the Review Agent (independent second opinion). Defaults to LLM_MODEL.
REVIEW_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813   # suggestion, UNTESTED

# --- Images: Black Forest Labs FLUX (key via QR code on slide 6)
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai/v1
BFL_MODEL=flux-2-pro

# --- Data paths (relative to where you run the command)
NUTRITION_CSV=data/nutrition/Schweizer_Nahrwertdatenbank(Generische Lebensmittel).csv
TEMPLATE_HTML=templates/Das-schmeckt-Recipe-Preview-A4.html
ARCHIVE_DIR=data/recipe_export/rezepte_export
TOPICMAP_SQL_ZIP=data/recipe-archive/rezepte_export_topicmap.sql.zip
OUTPUT_DIR=output
# BRAND_RULES_JSON=output/brand_rules.json   # Person A's distilled MarkenCI rules (optional)

# OFFLINE=1  -> mock LLM + placeholder images (demo without network)
