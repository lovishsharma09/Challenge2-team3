{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["proposals", "rejected_topics"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "title", "topic", "trend", "brand_fit", "archive", "recipe_ideas", "rank_score", "rank"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "topic": {"type": "string"},
          "trend": {
            "type": "object",
            "required": ["score", "points", "why_relevant", "sources"],
            "properties": {
              "score": {"type": "number"},
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["date", "value", "source"]
                }
              },
              "sparkline": {"type": "array", "items": {"type": "number"}},
              "why_relevant": {"type": "string"},
              "sources": {"type": "array", "items": {"type": "string"}}
            }
          },
          "brand_fit": {"type": "object"},
          "archive": {
            "type": "object",
            "required": ["status", "available", "match_status", "similar_recipes", "repetition_risk", "content_gap", "assumption"],
            "properties": {
              "status": {"type": "string"},
              "available": {"type": "boolean"},
              "match_status": {"enum": ["matches_found", "no_match_found", "archive_unavailable"]},
              "similar_recipes": {"type": "array"},
              "repetition_risk": {"enum": ["low", "medium", "high", "unknown"]},
              "content_gap": {"type": "string"},
              "assumption": {"type": "string"}
            }
          },
          "recipe_ideas": {"type": "array", "items": {"type": "string"}},
          "rank_score": {"type": "number"},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "rejected_topics": {"type": "array"}
  }
}
